# ===========================
# Anthropic API Configuration
# ===========================
ANTHROPIC_API_KEY=sk-ant-v4-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===========================
# 楽天証券 API Configuration
# ===========================
RAKUTEN_CLIENT_ID=your_client_id
RAKUTEN_CLIENT_SECRET=your_client_secret

# ===========================
# Trading Configuration
# ===========================
# Mode: demo / live_mini / live
TRADING_MODE=demo

# Initial portfolio value (¥)
PORTFOLIO_VALUE=1000000

# Position size multiplier (1.0 = full size, 0.1 = 1/10)
POSITION_MULTIPLIER=1.0

# ===========================
# Risk Management Settings
# ===========================
# Maximum number of open positions
MAX_POSITIONS=5

# Maximum position size as % of portfolio (0.20 = 20%)
MAX_POSITION_PERCENT=0.20

# Maximum risk per trade as % of portfolio
MAX_RISK_PER_TRADE=0.02

# Maximum daily loss % before stopping trading
MAX_DAILY_LOSS_PERCENT=0.05

# ===========================
# Trading Rules
# ===========================
# Stop loss percentage (0.05 = 5%)
STOP_LOSS_PERCENT=0.05

# Take profit percentage (0.10 = 10%)
TAKE_PROFIT_PERCENT=0.10

# Confidence threshold for trading (0.65 = 65%)
CONFIDENCE_THRESHOLD=0.65

# ===========================
# Watched Stocks (Comma-separated)
# ===========================
WATCHED_STOCKS=7203,6758,9984,8306,2802

# ===========================
# Logging
# ===========================
LOG_LEVEL=info
LOG_DIR=logs

# ===========================
# Database
# ===========================
DB_PATH=database/trades.db
