logs/
*.log
npm-debug.log*
yarn-debug.log*

# ─── IDE・エディタ ────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath

# ─── OS ──────────────────────────────────────────────────────
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
Desktop.ini

# ─── エクスポート・一時ファイル ───────────────────────────────
exports/
*.csv
*.xlsx
tmp/
temp/

# ─── キャッシュ ───────────────────────────────────────────────
.cache/
*.cache
.npm/
.eslintcache

# ─── Streamlit ───────────────────────────────────────────────
.streamlit/

